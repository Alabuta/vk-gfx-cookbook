---
Language: Cpp
Standard: Latest
BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
IndentCaseLabels: false
NamespaceIndentation: All
IndentPPDirectives: AfterHash
PPIndentWidth: 2

# Braces
BreakBeforeBraces: Allman
InsertBraces: false

# Line width
ColumnLimit: 120

# Alignment
# Type-centric: pointer/reference bind to the type (`T* p`, `T& r`), not the declarator.
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
QualifierAlignment: Right
# When a paren/brace list breaks, break after the opening bracket and place the
# closing bracket on its own line (closing `}` of a multi-line braced initializer
# lands on its own line; single-line lists stay compact).
AlignAfterOpenBracket: BlockIndent
AlignOperands: Align
LambdaBodyIndentation: OuterScope

# Bin packing: each parameter / argument / designated initializer on its own line
# once the list is broken across lines.
BinPackParameters: false
BinPackArguments: false

# Short forms
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: Inline
AllowShortBlocksOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Templates
BreakTemplateDeclarations: Yes

# Comments — keep one space before trailing `//`, never column-align across lines.
AlignTrailingComments:
  Kind: Never
  OverEmptyLines: 0

# Includes
SortIncludes: Never

# Spaces
SpaceBeforeParens: ControlStatements
SpacesInAngles: Never
SpaceAfterTemplateKeyword: true

# Other
EmptyLineBeforeAccessModifier: Always
EmptyLineAfterAccessModifier: Never
SeparateDefinitionBlocks: Always
PackConstructorInitializers: CurrentLine
BreakConstructorInitializers: BeforeComma
