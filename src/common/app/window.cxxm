module;

#include <cstdint>
#include <string>

#include <volk.h>
#include <GLFW/glfw3.h>

export module vkgc.window;

export namespace vkgc
{
    class window
    {
    public:

        window(std::string const& title, std::uint32_t width, std::uint32_t height) noexcept;
        ~window();

        window(window const&) = delete;
        window(window&& other) = delete;

        window& operator=(window const&) = delete;
        window& operator=(window&& other) = delete;

        [[nodiscard]] bool is_valid() const noexcept;
        [[nodiscard]] GLFWwindow* handle() const noexcept;

        [[nodiscard]] bool should_close() const noexcept;

        [[nodiscard]] VkSurfaceKHR create_vulkan_surface(VkInstance instance) const noexcept;

    private:

        GLFWwindow* handle_{nullptr};
    };
}
