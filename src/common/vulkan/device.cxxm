module;

#include <cstdint>
#include <limits>
#include <vector>
#include <string>

#include <volk.h>
#include "vk_mem_alloc.h"

export module vkgc.vulkan_device;

export namespace vkgc
{
    struct vulkan_device_info
    {
        VkSurfaceKHR surface{VK_NULL_HANDLE};
        std::vector<std::string> extensions{};
    };

    struct vulkan_queue_families
    {
        std::uint32_t main{std::numeric_limits<std::uint32_t>::max()};
        std::uint32_t dedicated_compute{std::numeric_limits<std::uint32_t>::max()};
        std::uint32_t dedicated_transfer{std::numeric_limits<std::uint32_t>::max()};
    };

    class vulkan_device final
    {
    public:

        vulkan_device() noexcept = default;

        vulkan_device(
            VkPhysicalDevice physical_device,
            VkDevice handle,
            vulkan_queue_families queue_families,
            VmaAllocator vma_allocator) noexcept;

        ~vulkan_device();

        vulkan_device(vulkan_device const&) = delete;
        vulkan_device(vulkan_device&&) = delete;

        vulkan_device& operator=(vulkan_device const&) = delete;
        vulkan_device& operator=(vulkan_device&&) = delete;

        [[nodiscard]] bool is_valid() const noexcept;

        [[nodiscard]] VkPhysicalDevice physical_device() const noexcept;
        [[nodiscard]] VkDevice handle() const noexcept;

        [[nodiscard]] VkPhysicalDeviceProperties const& properties() const noexcept;
        [[nodiscard]] VkPhysicalDeviceMemoryProperties const& memory_properties() const noexcept;

        // True when a device-local, host-visible heap larger than the standard 256 MiB BAR window
        // is present, i.e. the driver exposes ReBAR / Smart Access Memory.
        [[nodiscard]] bool has_rebar() const noexcept;
        // Index of the preferred ReBAR memory type (DEVICE_LOCAL | HOST_VISIBLE [| HOST_COHERENT]).
        // Only meaningful when has_rebar() == true.
        [[nodiscard]] std::uint32_t rebar_memory_type_index() const noexcept;

        [[nodiscard]] VmaAllocator vma_allocator() const noexcept;

        [[nodiscard]] VkQueue main_queue() const noexcept;
        [[nodiscard]] std::uint32_t main_queue_family_index() const noexcept;

        [[nodiscard]] VkQueue dedicated_compute_queue() const noexcept;
        [[nodiscard]] std::uint32_t dedicated_compute_queue_family_index() const noexcept;

        [[nodiscard]] VkQueue dedicated_transfer_queue() const noexcept;
        [[nodiscard]] std::uint32_t dedicated_transfer_queue_family_index() const noexcept;

        VkResult set_debug_object_name(VkObjectType type, std::uint64_t handle, char const* name) const;

    private:

        VkPhysicalDevice physical_device_{VK_NULL_HANDLE};
        VkDevice handle_{VK_NULL_HANDLE};

        vulkan_queue_families queue_families_{};

        std::uint32_t rebar_memory_type_index_{std::numeric_limits<std::uint32_t>::max()};

        VmaAllocator vma_allocator_{VK_NULL_HANDLE};

        VkPhysicalDeviceProperties2 device_properties_{};
        VkPhysicalDeviceMemoryProperties2 memory_properties_{};

        VkQueue main_queue_{VK_NULL_HANDLE};
        VkQueue dedicated_compute_queue_{VK_NULL_HANDLE};
        VkQueue dedicated_transfer_queue_{VK_NULL_HANDLE};
    };
}
