module;

#include <cstdint>

export module vkgc.vulkan_handle;

export namespace vkgc
{
    template <typename T>
    struct vk_object_handle
    {
        using tag = T;

        std::uint32_t index{0};
        std::uint32_t generation{0};

        [[nodiscard]]
        bool is_valid() const noexcept
        {
            return generation != 0;
        }
    };

    using vk_image_handle = vk_object_handle<struct vk_object_tag_image>;
    using vk_image_view_handle = vk_object_handle<struct vk_object_tag_image_view>;
    using vk_sampler_handle = vk_object_handle<struct vk_object_tag_sampler>;
    using vk_buffer_handle = vk_object_handle<struct vk_object_tag_buffer>;
    using vk_allocation_handle = vk_object_handle<struct vk_object_tag_allocation>;
    using vk_fence_handle = vk_object_handle<struct vk_object_tag_fence>;
    using vk_bin_semaphore_handle = vk_object_handle<struct vk_object_tag_bin_semaphore>;
    using vk_timeline_semaphore_handle = vk_object_handle<struct vk_object_tag_timeline_semaphore>;
    using vk_command_pool_handle = vk_object_handle<struct vk_object_tag_command_pool>;
    using vk_command_buffer_handle = vk_object_handle<struct vk_object_tag_command_buffer>;
    using vk_shader_handle = vk_object_handle<struct vk_object_tag_shader>;
    using vk_descriptor_set_layout_handle = vk_object_handle<struct vk_object_tag_descriptor_set_layout>;
    using vk_descriptor_pool_handle = vk_object_handle<struct vk_object_tag_descriptor_pool>;
    using vk_descriptor_set_handle = vk_object_handle<struct vk_object_tag_descriptor_set>;
    using vk_pipeline_layout_handle = vk_object_handle<struct vk_object_tag_pipeline_layout>;
    using vk_pipeline_handle = vk_object_handle<struct vk_object_tag_pipeline>;
    using vk_pipeline_cache_handle = vk_object_handle<struct vk_object_tag_pipeline_cache>;
}
