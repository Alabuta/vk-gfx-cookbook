module;

#include <bit>
#include <cstddef>
#include <cstdint>
#include <tuple>
#include <utility>
#include <vector>
#include <span>

#include <volk.h>
#include "vk_mem_alloc.h"

export module vkgc.vulkan_object_registry;

import vkgc.vulkan_handle;
import vkgc.vulkan_slot_map;
import vkgc.vulkan_device;
export import vkgc.vulkan_payload;

export namespace vkgc
{
    struct shader_create_info
    {
        VkShaderStageFlagBits stage{};
        VkShaderStageFlags next_stage{0};
        char const* entry_point{nullptr};
        char const* debug_name{""};
    };

    // Flattened read-only snapshot of an image payload: what barrier recording and descriptor
    // writes need, resolved in one lookup instead of one per field. Owns nothing.
    struct gpu_image
    {
        VkImage image{VK_NULL_HANDLE};
        VkImageView view{VK_NULL_HANDLE};

        vk_allocation_handle allocation{};

        image_desc desc{};

        VkImageLayout steady_state_layout{VK_IMAGE_LAYOUT_UNDEFINED};
        std::uint32_t bindless_slot{kInvalidBindlessSlot};
    };

    class vulkan_object_registry final
    {
    public:

        explicit vulkan_object_registry(vulkan_device const& device) noexcept;
        ~vulkan_object_registry();

        vulkan_object_registry(vulkan_object_registry const&) = delete;
        vulkan_object_registry(vulkan_object_registry&&) = delete;

        vulkan_object_registry& operator=(vulkan_object_registry const&) = delete;
        vulkan_object_registry& operator=(vulkan_object_registry&&) = delete;

        // Creates the image and, unless `registration` opts out or the usage flags don't call for
        // one, a full-resource default view owned by the same payload.
        [[nodiscard]]
        vk_image_handle create_image(
            VkImageCreateInfo const& info,
            image_registration const& registration = {},
            char const* debug_name = "");

        [[nodiscard]]
        vk_image_handle create_memory_bound_image(
            VkImageCreateInfo const& image_info,
            VmaAllocationCreateInfo const& allocation_info,
            image_registration const& registration = {},
            char const* debug_name = "");

        [[nodiscard]]
        vk_allocation_handle allocate_image_memory(vk_image_handle image, VmaAllocationCreateInfo const& alloc_info);

        [[nodiscard]]
        vk_buffer_handle create_buffer(VkBufferCreateInfo const& info, char const* debug_name = "");

        [[nodiscard]]
        vk_buffer_handle create_memory_bound_buffer(
            VkBufferCreateInfo const& buffer_info,
            VmaAllocationCreateInfo const& allocation_info,
            char const* debug_name = "");

        [[nodiscard]]
        vk_allocation_handle allocate_buffer_memory(vk_buffer_handle buffer, VmaAllocationCreateInfo const& alloc_info);

        [[nodiscard]]
        vk_image_view_handle create_image_view(VkImageViewCreateInfo const& info, char const* debug_name = "");

        [[nodiscard]]
        vk_sampler_handle create_sampler(VkSamplerCreateInfo const& info, char const* debug_name = "");

        [[nodiscard]]
        vk_fence_handle create_fence(bool create_signaled, char const* debug_name = "");

        [[nodiscard]]
        vk_bin_semaphore_handle create_binary_semaphore(char const* debug_name = "");

        [[nodiscard]]
        vk_timeline_semaphore_handle create_timeline_semaphore(
            std::uint64_t initial_value,
            char const* debug_name = "");

        [[nodiscard]]
        vk_command_pool_handle create_command_pool(VkCommandPoolCreateInfo const& info, char const* debug_name = "");

        [[nodiscard]]
        std::vector<vk_command_buffer_handle> allocate_command_buffers(
            vk_command_pool_handle pool,
            std::uint32_t count,
            bool is_primary);

        [[nodiscard]]
        std::vector<vk_shader_handle> create_shaders(
            std::span<shader_create_info const> infos,
            std::span<std::byte const> shader_code);

        [[nodiscard]]
        vk_descriptor_set_layout_handle create_descriptor_set_layout(
            VkDescriptorSetLayoutCreateInfo const& info,
            char const* debug_name = "");

        [[nodiscard]]
        vk_descriptor_pool_handle create_descriptor_pool(
            VkDescriptorPoolCreateInfo const& info,
            char const* debug_name = "");

        // Allocates one descriptor set per layout. `variable_descriptor_counts` must be
        // empty or match `layouts` in size; a non-empty span is chained as
        // VkDescriptorSetVariableDescriptorCountAllocateInfo (a variable-count binding
        // allocates with count zero when nothing is chained).
        [[nodiscard]]
        std::vector<vk_descriptor_set_handle> allocate_descriptor_sets(
            vk_descriptor_pool_handle pool,
            std::span<vk_descriptor_set_layout_handle const> layouts,
            std::span<std::uint32_t const> variable_descriptor_counts = {},
            char const* debug_name = "");

        [[nodiscard]]
        vk_pipeline_layout_handle create_pipeline_layout(
            VkPipelineLayoutCreateInfo const& info,
            char const* debug_name = "");

        [[nodiscard]]
        vk_pipeline_cache_handle create_pipeline_cache_from_data(
            std::span<std::byte const> cache_data,
            char const* debug_name = "");

        [[nodiscard]]
        vk_pipeline_cache_handle create_pipeline_cache_empty(char const* debug_name = "");

        [[nodiscard]]
        vk_pipeline_handle create_graphics_pipeline(
            VkGraphicsPipelineCreateInfo const& info,
            vk_pipeline_cache_handle cache = {},
            char const* debug_name = "");

        // Resolve the underlying Vulkan object from a handle. Returns VK_NULL_HANDLE-of-T for stale handles.
        template <typename Handle>
        [[nodiscard]]
        auto resolve_handle(Handle const handle) const noexcept
        {
            using payload_type = vk_object_payload<Handle>;
            using vk_type = decltype(payload_type{}.handle);

            payload_type const* p = slot_map<Handle>().try_get(handle);
            return p != nullptr ? p->handle : vk_type{VK_NULL_HANDLE};
        }

        // Caller ensures no GPU work references the resource.
        // The frame ring is responsible for deferring the call until that's guaranteed.
        template <typename Handle>
        void destroy_immediate(Handle const handle)
        {
            auto& slots = slot_map<Handle>();
            if (!slots.is_alive(handle))
            {
                return;
            }

            vk_object_payload<Handle> payload = slots.release(handle);
            destroy_payload(std::move(payload));
        }

        template <typename Handle>
        [[nodiscard]]
        bool is_alive(Handle const handle) const noexcept
        {
            return slot_map<Handle>().is_alive(handle);
        }

        // Resolves a handle into everything the image carries, native view included.
        // Returns a fully null gpu_image for a stale handle.
        [[nodiscard]]
        gpu_image resolve_image(vk_image_handle handle) const noexcept;

        [[nodiscard]]
        VkDeviceSize buffer_size(vk_buffer_handle handle) const noexcept;

        [[nodiscard]]
        vk_allocation_handle bound_allocation(vk_buffer_handle handle) const noexcept;

        // Serializes the pipeline cache's contents for persistence across runs.
        // Returns an empty vector for a stale handle or on query failure.
        [[nodiscard]]
        std::vector<std::byte> pipeline_cache_data(vk_pipeline_cache_handle handle) const;

        [[nodiscard]]
        vulkan_device const& device() const noexcept { return device_; }

    private:

        using slot_map_tuple = std::tuple<
            vulkan_slot_map<vk_image_handle, vk_object_payload<vk_image_handle>>,
            vulkan_slot_map<vk_image_view_handle, vk_object_payload<vk_image_view_handle>>,
            vulkan_slot_map<vk_sampler_handle, vk_object_payload<vk_sampler_handle>>,
            vulkan_slot_map<vk_buffer_handle, vk_object_payload<vk_buffer_handle>>,
            vulkan_slot_map<vk_allocation_handle, vk_object_payload<vk_allocation_handle>>,
            vulkan_slot_map<vk_fence_handle, vk_object_payload<vk_fence_handle>>,
            vulkan_slot_map<vk_bin_semaphore_handle, vk_object_payload<vk_bin_semaphore_handle>>,
            vulkan_slot_map<vk_timeline_semaphore_handle, vk_object_payload<vk_timeline_semaphore_handle>>,
            vulkan_slot_map<vk_command_pool_handle, vk_object_payload<vk_command_pool_handle>>,
            vulkan_slot_map<vk_command_buffer_handle, vk_object_payload<vk_command_buffer_handle>>,
            vulkan_slot_map<vk_shader_handle, vk_object_payload<vk_shader_handle>>,
            vulkan_slot_map<vk_descriptor_set_layout_handle, vk_object_payload<vk_descriptor_set_layout_handle>>,
            vulkan_slot_map<vk_descriptor_pool_handle, vk_object_payload<vk_descriptor_pool_handle>>,
            vulkan_slot_map<vk_descriptor_set_handle, vk_object_payload<vk_descriptor_set_handle>>,
            vulkan_slot_map<vk_pipeline_layout_handle, vk_object_payload<vk_pipeline_layout_handle>>,
            vulkan_slot_map<vk_pipeline_handle, vk_object_payload<vk_pipeline_handle>>,
            vulkan_slot_map<vk_pipeline_cache_handle, vk_object_payload<vk_pipeline_cache_handle>>
        >;

        vulkan_device const& device_;
        slot_map_tuple slot_maps_;

        // Shared tail of create_image / create_memory_bound_image: derives the immutable
        // description, eagerly creates the default view, and registers the finished payload.
        [[nodiscard]]
        vk_image_handle finalize_created_image(
            VkImage image,
            vk_allocation_handle allocation,
            VkImageCreateInfo const& info,
            image_registration const& registration,
            char const* debug_name);

        template <typename T, typename S>
        auto slot_map(this S&& self) noexcept
            -> std::conditional_t<
                std::is_const_v<std::remove_reference_t<S>>,
                vulkan_slot_map<T, vk_object_payload<T>> const&, vulkan_slot_map<T, vk_object_payload<T>>&>
        {
            return std::get<vulkan_slot_map<T, vk_object_payload<T>>>(self.slot_maps_);
        }

        template <typename Handle, typename NativeHandle, typename... PayloadArgs>
        [[nodiscard]]
        Handle finalize_created_object(
            VkObjectType const object_type,
            NativeHandle const native_handle,
            char const* const debug_name,
            PayloadArgs&&... payload_args)
        {
            device_.set_debug_object_name(object_type, std::bit_cast<std::uint64_t>(native_handle), debug_name);
            return slot_map<Handle>().emplace(native_handle, std::forward<PayloadArgs>(payload_args)...);
        }

        // finalize_created_object forwards payload fields positionally, which stops being safe once
        // a payload holds several same-typed fields in a row. This overload takes the payload
        // already built with designated initializers, so field order can't drift into a silent
        // mismatch. Prefer it for any payload wider than a couple of fields.
        template <typename Handle>
        [[nodiscard]]
        Handle finalize_created_payload(
            VkObjectType const object_type,
            char const* const debug_name,
            vk_object_payload<Handle>&& payload)
        {
            device_.set_debug_object_name(
                object_type,
                std::bit_cast<std::uint64_t>(payload.handle),
                debug_name);

            return slot_map<Handle>().emplace(std::move(payload));
        }

        // Routed through destroy_immediate so teardown-by-drain and teardown-by-handle can't
        // diverge: a payload that nests another object (an image owning its default view) frees
        // that nested handle itself, and only a released slot makes the nested free idempotent.
        // Destroying without releasing would double-free every nested object whose own pool
        // drains first.
        template <typename Handle>
        void drain_pool_in_destructor()
        {
            auto& slots = slot_map<Handle>();

            // Snapshot the live handles before touching anything: destroy_immediate releases as
            // it goes, and a nested free can reach into this very pool.
            std::vector<Handle> live_handles;
            live_handles.reserve(slots.live_count());

            slots.for_each_live([&live_handles](Handle const handle, vk_object_payload<Handle> const&)
            {
                live_handles.push_back(handle);
            });

            for (auto const handle : live_handles)
            {
                destroy_immediate(handle);
            }
        }

        /*
         * Per-payload destruction. One free function per payload type;
         * vulkan_object_registry::destroy_immediate<Handle> dispatches to the matching overload via the payload type.
         */
        void destroy_payload(vk_object_payload<vk_image_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_image_view_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_sampler_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_buffer_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_allocation_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_fence_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_bin_semaphore_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_timeline_semaphore_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_command_pool_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_command_buffer_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_shader_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_descriptor_set_layout_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_descriptor_pool_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_descriptor_set_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_pipeline_layout_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_pipeline_handle> const& payload) noexcept;
        void destroy_payload(vk_object_payload<vk_pipeline_cache_handle> const& payload) noexcept;
    };
}
