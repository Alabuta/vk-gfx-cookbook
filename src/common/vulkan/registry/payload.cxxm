module;

#include <cstdint>
#include <limits>

#include <volk.h>
#include "vk_mem_alloc.h"

export module vkgc.vulkan_payload;

import vkgc.vulkan_handle;

export namespace vkgc
{
    template <typename Handle>
    struct vk_object_payload;

    template <>
    struct vk_object_payload<vk_image_handle>
    {
        VkImage handle{VK_NULL_HANDLE};

        VkFormat format{VK_FORMAT_UNDEFINED};
        VkExtent3D extent{};
        std::uint32_t mip_levels{1};
        std::uint32_t array_layers{1};

        vk_allocation_handle allocation{};

        // :TODO: add default VkImageView, default bindless slot index and immutable desc

        // :TODO: add eager primary view (full resource access)
        // VkImageView default{VK_NULL_HANDLE};
        // uint32_t bindless_slot{0};

        // :TODO: add subresource views (lazy cache)
        // :TODO: add pre-allocated fast views (e.g., per-mip storage views for compute)

        // :TODO: add layout & synchronization tracking
        // VkImageLayout current_layout;
    };

    template <>
    struct vk_object_payload<vk_image_view_handle>
    {
        VkImageView handle{VK_NULL_HANDLE};
        VkFormat format{VK_FORMAT_UNDEFINED};
    };

    template <>
    struct vk_object_payload<vk_sampler_handle>
    {
        VkSampler handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_buffer_handle>
    {
        VkBuffer handle{VK_NULL_HANDLE};
        VkDeviceSize size{0};
        VkBufferUsageFlags usage{0};

        vk_allocation_handle allocation{};
    };

    template <>
    struct vk_object_payload<vk_allocation_handle>
    {
        VmaAllocation handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_fence_handle>
    {
        VkFence handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_bin_semaphore_handle>
    {
        VkSemaphore handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_timeline_semaphore_handle>
    {
        VkSemaphore handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_command_pool_handle>
    {
        VkCommandPool handle{VK_NULL_HANDLE};
        std::uint32_t queue_family_index{std::numeric_limits<std::uint32_t>::max()};
    };

    template <>
    struct vk_object_payload<vk_command_buffer_handle>
    {
        VkCommandBuffer handle{VK_NULL_HANDLE};
        VkCommandPool source_pool{VK_NULL_HANDLE};
        bool is_primary{false};
    };

    template <>
    struct vk_object_payload<vk_shader_handle>
    {
        VkShaderEXT handle{VK_NULL_HANDLE};
        VkShaderStageFlagBits stage{};
    };

    template <>
    struct vk_object_payload<vk_descriptor_set_layout_handle>
    {
        VkDescriptorSetLayout handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_descriptor_pool_handle>
    {
        VkDescriptorPool handle{VK_NULL_HANDLE};
        VkDescriptorPoolCreateFlags flags{0};
    };

    template <>
    struct vk_object_payload<vk_descriptor_set_handle>
    {
        VkDescriptorSet handle{VK_NULL_HANDLE};
        VkDescriptorPool source_pool{VK_NULL_HANDLE};
        // Individual vkFreeDescriptorSets is only legal when the source pool was created
        // with VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT; otherwise the set is
        // reclaimed by the pool's own destruction/reset.
        bool can_free{false};
    };

    template <>
    struct vk_object_payload<vk_pipeline_layout_handle>
    {
        VkPipelineLayout handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_pipeline_handle>
    {
        VkPipeline handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_pipeline_cache_handle>
    {
        VkPipelineCache handle{VK_NULL_HANDLE};
    };
}
