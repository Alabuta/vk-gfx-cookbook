module;

#include <cstdint>
#include <limits>

#include <volk.h>
#include "vk_mem_alloc.h"

export module vkgc.vulkan_payload;

import vkgc.vulkan_handle;

export namespace vkgc
{
    std::uint32_t constexpr kInvalidBindlessSlot{std::numeric_limits<std::uint32_t>::max()};

    [[nodiscard]]
    constexpr VkImageAspectFlags format_to_image_aspect(VkFormat format)
    {
        switch (format)
        {
        case VK_FORMAT_D16_UNORM:
            [[fallthrough]];
        case VK_FORMAT_X8_D24_UNORM_PACK32:
            [[fallthrough]];
        case VK_FORMAT_D32_SFLOAT:
            return VK_IMAGE_ASPECT_DEPTH_BIT;

        case VK_FORMAT_S8_UINT:
            return VK_IMAGE_ASPECT_STENCIL_BIT;

        case VK_FORMAT_D16_UNORM_S8_UINT:
            [[fallthrough]];
        case VK_FORMAT_D24_UNORM_S8_UINT:
            [[fallthrough]];
        case VK_FORMAT_D32_SFLOAT_S8_UINT:
            return VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;

        default:
            return VK_IMAGE_ASPECT_COLOR_BIT;
        }
    }

    // Creation-time knobs that have no home in VkImageCreateInfo. The defaults reproduce the
    // behaviour call sites had before the image payload grew a view and a bindless slot.
    struct image_registration
    {
        std::uint32_t bindless_slot{kInvalidBindlessSlot};
        VkImageLayout steady_state_layout{VK_IMAGE_LAYOUT_UNDEFINED};
        // Set explicitly to sample a depth-only view of a packed depth-stencil image:
        // a two-aspect view is legal as an attachment but not as a sampled descriptor.
        VkImageAspectFlags view_aspect{VK_IMAGE_ASPECT_NONE};
        bool create_default_view{true};
    };

    // Everything vkCreateImage was told, kept so call sites never re-derive it or thread it
    // alongside the handle. Immutable for the lifetime of the image.
    struct image_desc
    {
        VkFormat format{VK_FORMAT_UNDEFINED};
        VkExtent3D extent{};
        std::uint32_t mip_levels{1};
        std::uint32_t array_layers{1};
        VkImageType type{VK_IMAGE_TYPE_2D};
        VkSampleCountFlagBits samples{VK_SAMPLE_COUNT_1_BIT};
        VkImageUsageFlags usage{0};
        VkImageCreateFlags flags{0};
        VkImageAspectFlags aspect{VK_IMAGE_ASPECT_COLOR_BIT};
    };

    template <typename Handle>
    struct vk_object_payload;

    template <>
    struct vk_object_payload<vk_image_handle>
    {
        VkImage handle{VK_NULL_HANDLE};

        image_desc desc{};

        vk_allocation_handle allocation{};

        // Full-resource view created eagerly alongside the image; destroyed with it. Stays
        // invalid for images whose usage never needs one (transfer-only, staging).
        vk_image_view_handle default_view{};

        // Layout the resource rests in between passes, i.e. what a descriptor write for
        // default_view declares. Immutable — not a layout tracker.
        VkImageLayout steady_state_layout{VK_IMAGE_LAYOUT_UNDEFINED};

        // Index into the renderer's bindless sampled-image table, or kInvalidBindlessSlot.
        std::uint32_t bindless_slot{kInvalidBindlessSlot};

        // No subresource-view cache here: VkSlotMapPayload rules out owning containers in a
        // payload. Per-mip storage views belong in a side table keyed by the image handle.
    };

    template <>
    struct vk_object_payload<vk_image_view_handle>
    {
        VkImageView handle{VK_NULL_HANDLE};
        VkFormat format{VK_FORMAT_UNDEFINED};
    };

    template <>
    struct vk_object_payload<vk_sampler_handle>
    {
        VkSampler handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_buffer_handle>
    {
        VkBuffer handle{VK_NULL_HANDLE};
        VkDeviceSize size{0};
        VkBufferUsageFlags usage{0};

        vk_allocation_handle allocation{};
    };

    template <>
    struct vk_object_payload<vk_allocation_handle>
    {
        VmaAllocation handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_fence_handle>
    {
        VkFence handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_bin_semaphore_handle>
    {
        VkSemaphore handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_timeline_semaphore_handle>
    {
        VkSemaphore handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_command_pool_handle>
    {
        VkCommandPool handle{VK_NULL_HANDLE};
        std::uint32_t queue_family_index{std::numeric_limits<std::uint32_t>::max()};
    };

    template <>
    struct vk_object_payload<vk_command_buffer_handle>
    {
        VkCommandBuffer handle{VK_NULL_HANDLE};
        VkCommandPool source_pool{VK_NULL_HANDLE};
        bool is_primary{false};
    };

    template <>
    struct vk_object_payload<vk_shader_handle>
    {
        VkShaderEXT handle{VK_NULL_HANDLE};
        VkShaderStageFlagBits stage{};
    };

    template <>
    struct vk_object_payload<vk_descriptor_set_layout_handle>
    {
        VkDescriptorSetLayout handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_descriptor_pool_handle>
    {
        VkDescriptorPool handle{VK_NULL_HANDLE};
        VkDescriptorPoolCreateFlags flags{0};
    };

    template <>
    struct vk_object_payload<vk_descriptor_set_handle>
    {
        VkDescriptorSet handle{VK_NULL_HANDLE};
        VkDescriptorPool source_pool{VK_NULL_HANDLE};
        // Individual vkFreeDescriptorSets is only legal when the source pool was created
        // with VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT; otherwise the set is
        // reclaimed by the pool's own destruction/reset.
        bool can_free{false};
    };

    template <>
    struct vk_object_payload<vk_pipeline_layout_handle>
    {
        VkPipelineLayout handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_pipeline_handle>
    {
        VkPipeline handle{VK_NULL_HANDLE};
    };

    template <>
    struct vk_object_payload<vk_pipeline_cache_handle>
    {
        VkPipelineCache handle{VK_NULL_HANDLE};
    };
}
