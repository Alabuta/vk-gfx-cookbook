module;

#include <algorithm>
#include <cstdint>
#include <limits>
#include <new>
#include <type_traits>
#include <vector>

export module vkgc.vulkan_slot_map;

import vkgc.vulkan_handle;

export namespace vkgc
{
    /*
     * Slot-map payload constraints — make the underlying std::vector<slot_t> storage as
     * memory-efficient as possible, and wide enough to host an intrusive freelist
     * inside empty slots:
     *   - trivially_copyable: vector can memcpy on reallocation; slot_t moves
     *     are no-op bitwise copies (also implies noexcept move ctor/assign).
     *   - trivially_destructible: no destructor calls per slot on vector shrink
     *     or pool teardown (implied by trivially_copyable, asserted explicitly
     *     for documentation).
     *   - nothrow_default_constructible: `Payload{}` in slot_t default-init and
     *     in release()'s return cannot throw, so insert/release stay
     *     noexcept-friendly.
     *   - sizeof/alignof >= std::uint32_t: empty slots store a next-free index
     *     in a union with the payload (see slot_t below), so the payload bytes
     *     must be wide enough and properly aligned to host a std::uint32_t.
     */
    template <typename T>
    concept VkSlotMapPayload =
        std::is_trivially_copyable_v<T> &&
        std::is_trivially_destructible_v<T> &&
        std::is_nothrow_default_constructible_v<T> &&
        sizeof(T) >= sizeof(std::uint32_t) &&
        alignof(T) >= alignof(std::uint32_t);

    template <typename Tag, VkSlotMapPayload Payload>
    class vulkan_slot_map final
    {
    public:

        vulkan_slot_map() noexcept = default;
        ~vulkan_slot_map() = default;

        vulkan_slot_map(vulkan_slot_map const&) = delete;
        vulkan_slot_map(vulkan_slot_map&&) = delete;

        vulkan_slot_map& operator=(vulkan_slot_map const&) = delete;
        vulkan_slot_map& operator=(vulkan_slot_map&&) = delete;

        [[nodiscard]]
        vk_object_handle<Tag> insert(Payload payload)
        {
            std::uint32_t slot_index{0};

            if (head_free_ != no_free_slot)
            {
                slot_index = head_free_;
                head_free_ = slots_[slot_index].next_free;
                ::new (static_cast<void*>(&slots_[slot_index].payload)) Payload{payload};
            }
            else
            {
                slot_index = static_cast<std::uint32_t>(slots_.size());
                slots_.emplace_back();
                slots_[slot_index].payload = payload;
            }

            slot_t& slot = slots_[slot_index];
            slot.generation = std::max(1u, slot.generation + 1);

            ++live_count_;

            return vk_object_handle<Tag>{
                .index{slot_index},
                .generation{slot.generation}
            };
        }

        [[nodiscard]]
        Payload const* try_get(vk_object_handle<Tag> const handle) const noexcept
        {
            slot_t const* slot = locate(handle);
            return slot != nullptr ? &slot->payload : nullptr;
        }

        [[nodiscard]]
        bool is_alive(vk_object_handle<Tag> const handle) const noexcept
        {
            return locate(handle) != nullptr;
        }

        // Detaches the slot without performing any vkDestroy / vmaFreeMemory.
        // The caller (vulkan_object_registry) is responsible for releasing the
        // underlying VkXxx before invoking release().
        Payload release(vk_object_handle<Tag> handle)
        {
            slot_t* slot = locate(handle);
            if (slot == nullptr)
            {
                return Payload{};
            }

            Payload result{slot->payload};

            // Payload is trivially destructible (VkSlotMapPayload), so reusing the
            // union storage with placement-new ends its lifetime without a dtor call.
            ::new (static_cast<void*>(&slot->next_free)) std::uint32_t{head_free_};
            head_free_ = handle.index;
            slot->generation = 0;

            --live_count_;

            return result;
        }

        template <typename Fn>
        void for_each_live(Fn&& fn) const
        {
            for (std::uint32_t i = 0; i < slots_.size(); ++i)
            {
                auto&& slot = slots_[i];
                if (slot.generation == 0)
                {
                    continue;
                }

                vk_object_handle<Tag> handle{
                    .index{i},
                    .generation{slot.generation}
                };

                fn(handle, slot.payload);
            }
        }

        [[nodiscard]]
        std::uint32_t live_count() const noexcept
        {
            return live_count_;
        }

    private:

        struct slot_t
        {
            std::uint32_t generation{0};

            union
            {
                Payload payload;
                std::uint32_t next_free;
            };

            slot_t() noexcept
                : payload{}
            {
            }
        };

        static constexpr std::uint32_t no_free_slot = std::numeric_limits<std::uint32_t>::max();

        std::vector<slot_t> slots_{};
        std::uint32_t head_free_{no_free_slot};
        std::uint32_t live_count_{0};

        template <typename S>
        [[nodiscard]]
        auto locate(this S&& self, vk_object_handle<Tag> const handle) noexcept
            -> std::conditional_t<std::is_const_v<std::remove_reference_t<S>>, slot_t const*, slot_t*>
        {
            if (handle.generation == 0 || handle.index >= self.slots_.size())
            {
                return nullptr;
            }

            auto& slot = self.slots_[handle.index];
            return slot.generation == handle.generation ? &slot : nullptr;
        }
    };
}
