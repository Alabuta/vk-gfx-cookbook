module;

#include <cstdint>
#include <tuple>
#include <vector>

export module vkgc.vulkan_frame_ring;

import vkgc.vulkan_handle;
import vkgc.vulkan_object_registry;

export namespace vkgc
{
    class vulkan_frame_ring final
    {
    public:

        vulkan_frame_ring(vulkan_object_registry& object_registry, std::uint32_t frames_in_flight);
        ~vulkan_frame_ring();

        vulkan_frame_ring(vulkan_frame_ring const&) = delete;
        vulkan_frame_ring(vulkan_frame_ring&&) = delete;

        vulkan_frame_ring& operator=(vulkan_frame_ring const&) = delete;
        vulkan_frame_ring& operator=(vulkan_frame_ring&&) = delete;

        // Waits the timeline semaphore for the frame that previously used this
        // slot (frame_index - frames_in_flight) to complete, then drains that
        // slot's pending-destroy queue. Returns the slot index for recording.
        std::uint32_t begin_frame(std::uint64_t frame_index);

        // Marks the started frame as ended (records its index so the
        // destructor can wait the timeline up to it). Does not rotate the slot
        // cursor; the slot is chosen in begin_frame via frame_index modulo.
        void end_frame();

        [[nodiscard]]
        vk_timeline_semaphore_handle frame_slot_semaphore() const noexcept;

        [[nodiscard]]
        std::uint32_t frames_in_flight() const noexcept;

        // Enqueue a handle for destruction at the end of the current frame slot.
        // The actual destroy() runs the next time begin_frame() rotates
        // back to this slot (i.e. after the timeline semaphore reaches the
        // value signaled by the frame that used the slot).
        template <typename Tag>
        void defer_destroy(vk_object_handle<Tag> const handle)
        {
            auto& bucket = std::get<std::vector<vk_object_handle<Tag>>>(pending_queue_slots_[frame_slot_index_].buckets);
            bucket.push_back(handle);
        }

    private:

        struct pending_queue
        {
            // Match the declaration order with destruction order used by ~vulkan_object_registry.
            std::tuple<
                std::vector<vk_command_buffer_handle>,
                std::vector<vk_command_pool_handle>,
                std::vector<vk_image_view_handle>,
                std::vector<vk_image_handle>,
                std::vector<vk_buffer_handle>,
                std::vector<vk_allocation_handle>,
                std::vector<vk_bin_semaphore_handle>,
                std::vector<vk_timeline_semaphore_handle>,
                std::vector<vk_fence_handle>
            > buckets;
        };

        vulkan_object_registry& object_registry_;

        std::vector<pending_queue> pending_queue_slots_{};

        vk_timeline_semaphore_handle frame_slot_semaphore_;

        std::uint32_t const kFramesInFlight_;

        std::uint64_t started_frame_index_{0};
        std::uint64_t ended_frame_index_{0};

        std::uint32_t frame_slot_index_{0};

        void drain_slot(std::uint32_t slot_index);

        template <typename Tag>
        void drain_one(pending_queue& queue)
        {
            auto& bucket = std::get<std::vector<vk_object_handle<Tag>>>(queue.buckets);
            for (auto const handle : bucket)
            {
                object_registry_.destroy_immediate(handle);
            }

            bucket.clear();
        }
    };
}
