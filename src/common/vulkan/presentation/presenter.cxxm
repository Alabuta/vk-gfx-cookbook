module;

#include <cstdint>
#include <expected>
#include <span>
#include <vector>

#include <volk.h>

export module vkgc.vulkan_presenter;

import vkgc.vulkan_device;
import vkgc.vulkan_handle;
import vkgc.vulkan_object_registry;

export namespace vkgc
{
    struct swapchain_params
    {
        std::vector<VkSurfaceFormatKHR> preferred_surface_formats{};
        std::vector<VkPresentModeKHR> preferred_present_modes{};
        VkExtent2D framebuffer_extent{};
        std::uint32_t min_image_count{0};
        VkImageUsageFlags image_usage_flags{};
    };

    struct swapchain_create_info
    {
        VkExtent2D extent{};
        VkSurfaceFormatKHR surface_format{};
        VkPresentModeKHR present_mode{VK_PRESENT_MODE_FIFO_KHR};
        VkImageUsageFlags image_usage_flags{};
        std::uint32_t min_image_count{0};
        VkSurfaceTransformFlagBitsKHR pre_transform{VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR};
    };

    struct presenter_create_info
    {
        VkSurfaceKHR surface{VK_NULL_HANDLE};
        std::vector<VkSurfaceFormatKHR> preferred_surface_formats{};
        std::vector<VkPresentModeKHR> preferred_present_modes{};
        VkExtent2D image_extent{};
        std::uint32_t min_image_count{0};
        VkImageUsageFlags image_usage_flags{};
    };

    struct swapchain_image_acquire_result
    {
        vk_bin_semaphore_handle image_acquired{};
        vk_bin_semaphore_handle present_wait{};
        std::uint32_t image_index{0};
    };

    enum class present_status
    {
        ok,
        suboptimal,
        out_of_date,
        error
    };

    class vulkan_presenter final
    {
    public:

        vulkan_presenter(
            vulkan_device const& device,
            vulkan_object_registry& object_registry,
            VkSurfaceKHR surface,
            std::uint32_t frames_in_flight,
            swapchain_params const& swapchain_params);

        ~vulkan_presenter();

        vulkan_presenter(vulkan_presenter const&) = delete;
        vulkan_presenter(vulkan_presenter&&) = delete;

        vulkan_presenter& operator=(vulkan_presenter const&) = delete;
        vulkan_presenter& operator=(vulkan_presenter&&) = delete;

        [[nodiscard]]
        bool is_valid() const noexcept;

        [[nodiscard]]
        VkSwapchainKHR swapchain_handle() const noexcept;

        [[nodiscard]]
        std::span<VkImage const> images() const noexcept;

        [[nodiscard]]
        std::uint32_t image_count() const noexcept;

        [[nodiscard]]
        VkSurfaceFormatKHR surface_format() const noexcept;

        [[nodiscard]]
        VkExtent2D extent() const noexcept;

        // Acquires the next swapchain image using the slot-indexed
        // image_acquired_semaphores_[frame_index]. Returns the unexpected
        // present_status on VK_ERROR_OUT_OF_DATE_KHR or other failure;
        // VK_SUBOPTIMAL_KHR returns normally and the suboptimal status
        // surfaces at present(). The returned semaphore is pre-resolved for
        // the caller to wait on in vkQueueSubmit.
        [[nodiscard]]
        std::expected<swapchain_image_acquire_result, present_status> acquire_image(std::uint32_t frame_index);

        [[nodiscard]]
        present_status request_present(VkQueue queue);

        // vkDeviceWaitIdle, then destroy the previous swapchain and rebuild
        // (using oldSwapchain). image_acquired_semaphores_ are untouched
        // (sized by frames_in_flight, independent of image_count).
        void recreate_swapchain(
            VkSurfaceKHR surface,
            swapchain_params const& swapchain_params);

        // Marks the swapchain as needing rebuild. The next acquire_image()
        // returns present_status::out_of_date without touching the driver,
        // so the caller's existing out_of_date recovery path runs.
        void request_rebuild() noexcept;

        // Test-and-clear of the rebuild flag. Polled before begin_frame()
        // so the caller can run swapchain-dependent recovery without
        // entering the frame (begin_frame() resets the slot fence, and
        // skipping the rest of the frame would leave it unsignaled).
        [[nodiscard]]
        bool consume_rebuild_request() noexcept;

    private:

        vulkan_device const& device_;
        vulkan_object_registry& object_registry_;

        VkSwapchainKHR swapchain_handle_{VK_NULL_HANDLE};

        VkSurfaceFormatKHR surface_format_{};
        VkExtent2D surface_extent_{};

        std::vector<VkImage> swapchain_images_{};
        std::uint32_t acquired_image_index_{0};

        std::vector<vk_bin_semaphore_handle> image_acquired_semaphores_{};
        std::vector<vk_bin_semaphore_handle> present_semaphores_{};

        bool needs_rebuild_{false};

        void create_swapchain(VkSurfaceKHR surface, VkSwapchainKHR old_handle, swapchain_params const& swapchain_params);

        void query_swapchain_images();

        bool create_semaphores(std::uint32_t image_acquired_count, std::uint32_t present_wait_count);
        void destroy_semaphores();
    };
}
