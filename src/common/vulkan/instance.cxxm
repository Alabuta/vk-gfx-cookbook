module;

#include <cstdint>
#include <string>
#include <vector>

#include <volk.h>

#include "config.hxx"

export module vkgc.vulkan_instance;

import vkgc.vulkan_device;

export namespace vkgc
{
    std::uint32_t inline constexpr kVulkanApiVersion{
        VK_MAKE_API_VERSION(0, COOKBOOK_VULKAN_API_VERSION_MAJOR, COOKBOOK_VULKAN_API_VERSION_MINOR, 0)
    };

    struct vulkan_instance_info
    {
        std::vector<std::string> extensions{};
        std::vector<std::string> validation_layers{};
        bool enable_validation{false};
    };

    class vulkan_instance final
    {
    public:

        explicit vulkan_instance(vulkan_instance_info const& info) noexcept;
        ~vulkan_instance();

        vulkan_instance(vulkan_instance const&) = delete;
        vulkan_instance(vulkan_instance&&) = delete;

        vulkan_instance& operator=(vulkan_instance const&) = delete;
        vulkan_instance& operator=(vulkan_instance&&) = delete;

        [[nodiscard]] bool is_valid() const noexcept;
        [[nodiscard]] VkInstance handle() const noexcept;

        [[nodiscard]] vulkan_device create_device(vulkan_device_info const& info) noexcept;

    private:

        VkInstance handle_{VK_NULL_HANDLE};
        VkDebugUtilsMessengerEXT debug_utils_messenger_{VK_NULL_HANDLE};
    };
}
