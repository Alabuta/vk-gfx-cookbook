module;

#include <source_location>
#include <string_view>

export module vkgc.diagnostic;

// Note: `<atomic>` is deliberately NOT included here. On MinGW/libstdc++,
// `<atomic>` transitively pulls in gthr-default.h, whose inline functions
// reference pthread symbols declared with internal linkage — exposing those
// from a module interface unit is ill-formed ([basic.link]/15).
//
// The "log at most once" atomic-flag handling therefore lives at the macro
// call site in `diagnostic/assert.hxx`; this module just formats and prints.

export namespace vkgc::assert_detail
{
    // Format a fatal log line and flush stderr. Caller is responsible for
    // triggering the actual debug-break / abort after invoking this.
    void fatal_log(
        std::string_view log_category,
        std::string_view expression,
        std::string_view message,
        std::source_location location) noexcept;

    // Format a non-fatal "ensure" violation and flush stderr. Caller owns
    // the once-only gating (via a static `std::atomic_flag` in the macro).
    void ensure_log(
        std::string_view log_category,
        std::string_view expression,
        std::string_view message,
        std::source_location location) noexcept;
}
